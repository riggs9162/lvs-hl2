VertexLitGeneric
{
	$baseTexture	models/combine_apc/apc01blue_hires
	$color2 "[.875 .875 .875]"
	$surfaceprop metal
	$envmap env_cubemap
	$envmapcontrast .8
	$envmapsaturation .5
	$envmaptint "[ .375 .45 .5]"
	$basealphaenvmapmask 1
	// The glow lights up with the headlights: LVS raises $detailblendfactor while they are on.
	"$detail" "models/combine_apc/apc01glow"
	"$detailscale" 1
	"$detailblendmode" 5
	"$detailblendfactor" 0
}
